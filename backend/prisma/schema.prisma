generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  email          String           @unique
  passwordHash   String           @map("password_hash")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  role           UserRole         @default(USER)
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  preferences    UserPreference[]

  @@map("users")
}

model Source {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  slug       String      @unique
  websiteUrl String      @map("website_url")
  type       SourceType
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  scrapeRuns ScrapeRun[]
  stories    Story[]

  @@map("sources")
}

model ScrapeRun {
  id          String          @id @default(uuid()) @db.Uuid
  sourceId    String          @map("source_id") @db.Uuid
  startedAt   DateTime        @default(now()) @map("started_at")
  completedAt DateTime?       @map("completed_at")
  durationMs  Int?            @map("duration_ms")
  status      ScrapeRunStatus @default(RUNNING)
  fetched     Int             @default(0)
  inserted    Int             @default(0)
  updated     Int             @default(0)
  skipped     Int             @default(0)
  error       String?
  source      Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt(sort: Desc)])
  @@index([status])
  @@map("scrape_runs")
}

model Story {
  id             String           @id @default(uuid()) @db.Uuid
  sourceId       String           @map("source_id") @db.Uuid
  externalId     String           @map("external_id")
  canonicalUrl   String           @map("canonical_url")
  title          String
  author         String?
  content        String?
  excerpt        String?
  contentStatus  ContentStatus    @default(EXTERNAL_ONLY) @map("content_status")
  publishedAt    DateTime?        @map("published_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  clusterId      String?          @map("cluster_id") @db.Uuid
  points         Int?
  aiSummaries    AISummary[]
  biasAnalysis   BiasAnalysis?
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  cluster        StoryCluster?    @relation(fields: [clusterId], references: [id])
  source         Source           @relation(fields: [sourceId], references: [id])
  storyTopics    StoryTopic[]

  @@unique([sourceId, externalId])
  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@index([clusterId])
  @@map("stories")
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@map("bookmarks")
}

model ReadingHistory {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  storyId         String   @map("story_id") @db.Uuid
  openedAt        DateTime @default(now()) @map("opened_at")
  durationSeconds Int?     @map("duration_seconds")
  completed       Boolean  @default(false)
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, openedAt(sort: Desc)])
  @@map("reading_history")
}

model Topic {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  createdAt   DateTime         @default(now()) @map("created_at")
  storyTopics StoryTopic[]
  preferences UserPreference[]

  @@map("topics")
}

model StoryTopic {
  storyId String @map("story_id") @db.Uuid
  topicId String @map("topic_id") @db.Uuid
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([storyId, topicId])
  @@index([topicId, storyId])
  @@map("story_topics")
}

model StoryCluster {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  stories     Story[]

  @@map("story_clusters")
}

model UserPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  topicId    String   @map("topic_id") @db.Uuid
  preference Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_preferences")
}

model AISummary {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  summary   String
  model     String
  version   String
  entities  Json?
  createdAt DateTime @default(now()) @map("created_at")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, model, version])
  @@map("ai_summaries")
}

model BiasAnalysis {
  id         String   @id @default(uuid()) @db.Uuid
  storyId    String   @unique @map("story_id") @db.Uuid
  biasScore  Float    @map("bias_score")
  tone       String
  confidence Float
  signals    String?
  createdAt  DateTime @map("created_at") @db.Timestamp(6)
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("bias_analysis")
}

enum UserRole {
  USER
  ADMIN
}

enum SourceType {
  WEBSITE
  RSS
  API
}

enum ScrapeRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ContentStatus {
  FULL
  SUMMARY_ONLY
  EXTERNAL_ONLY
}
