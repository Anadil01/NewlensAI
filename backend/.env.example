NODE_ENV=development
PORT=5001

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/newslens

# Required at boot. Must be at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=newslens-api
JWT_AUDIENCE=newslens-web
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Required at boot. Must be a redis:// or rediss:// URL.
REDIS_URL=redis://localhost:6379

ELASTICSEARCH_URL=http://localhost:9200

CLIENT_URL=http://localhost:5173

# Read by the Python ingestion service, which loads this same file.
# NEWS_API_KEY is validated lazily, so an HN-only or summarization-only
# run works without it.
NEWS_API_KEY=
OPENROUTER_API_KEY=

# Python interpreter the backend uses to invoke the ingestion pipeline.
# Point this at the ingestion virtualenv, e.g. ../ingestion/venv/bin/python
PYTHON_BIN=
